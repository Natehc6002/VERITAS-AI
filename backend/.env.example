# VERITAS AI backend — example environment configuration.
# Copy this file to `.env` and adjust values for your machine.

# Application
APP_NAME=VERITAS AI
DEBUG=true

# Database (SQLite; relative paths resolve against the backend/ directory)
DATABASE_URL=sqlite:///./veritas.db

# Document storage directory (relative paths resolve against backend/)
UPLOAD_DIR=./uploads

# Maximum upload size in megabytes
MAX_UPLOAD_SIZE_MB=20

# Comma-separated list of allowed CORS origins (no wildcards in production)
ALLOWED_ORIGINS=http://localhost:5173
